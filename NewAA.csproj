    </Reference>
    <Reference Include="Brutal.Glfw">
      <HintPath>$(KsaInstallDir)Brutal.Glfw.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Tomlet">
      <HintPath>$(KsaInstallDir)Tomlet.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.ImGui.Abstractions">
      <HintPath>$(KsaInstallDir)Brutal.ImGui.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CommunityToolkit.HighPerformance">
