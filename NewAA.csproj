  </ItemGroup>

  <!--
    Harmony for patching. The game does not ship it. If StarMap provides its own
    copy, delete this PackageReference and reference StarMap's DLL instead.
  -->
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
    <PackageReference Include="StarMap.API" Version="0.3.6" />
  </ItemGroup>

  <!-- Copy the built mod (DLL, mod.toml, Content/) into the game's mods folder. -->
  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(DeployMod)' == 'true'">
    <MakeDir Directories="$(KsaModDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(KsaModDir)" />
    <Copy SourceFiles="mod.toml" DestinationFolder="$(KsaModDir)" />
    <Copy SourceFiles="Native\NewAANgx.dll" DestinationFolder="$(KsaModDir)" Condition="Exists('Native\NewAANgx.dll')" />
    <!-- The DLSS runtime NGX loads from the mod folder. 55 MB, so it is only copied when it changed. -->
    <Copy SourceFiles="DLSS_SDK\lib\Windows_x86_64\rel\nvngx_dlss.dll" DestinationFolder="$(KsaModDir)" SkipUnchangedFiles="true" Condition="Exists('DLSS_SDK\lib\Windows_x86_64\rel\nvngx_dlss.dll')" />
    <ItemGroup>
      <ModContent Include="Content\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModContent)" DestinationFiles="@(ModContent->'$(KsaModDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="Mod deployed to $(KsaModDir)" />
  </Target>

</Project>
