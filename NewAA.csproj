<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FXAA mod for Kitten Space Agency.
    Build:   dotnet build -c Release
    Override paths on the command line if your install differs, e.g.:
      dotnet build -c Release -p:KsaInstallDir="D:\Games\KSA\" -p:KsaModDir="C:\Users\me\Documents\My Games\Kitten Space Agency\mods\newaa\"
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>newaa</AssemblyName>
    <RootNamespace>KSA.Mods.NewAA</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Folder containing KSA.dll and its DLLs. Must end with a backslash. -->
    <KsaInstallDir Condition="'$(KsaInstallDir)' == ''">C:\Program Files\Kitten Space Agency\</KsaInstallDir>
    <!-- Where the game loads mods from. Copied here after every build. -->
    <KsaModDir Condition="'$(KsaModDir)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.Personal))\My Games\Kitten Space Agency\mods\newaa\</KsaModDir>
    <!-- Set to false to skip copying into the mods folder. -->
    <DeployMod Condition="'$(DeployMod)' == ''">true</DeployMod>
  </PropertyGroup>

  <!-- The game itself. Private=false so these are never copied into the mod folder. -->
  <ItemGroup>
    <Reference Include="KSA">
      <HintPath>$(KsaInstallDir)KSA.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Logging">
      <HintPath>$(KsaInstallDir)Brutal.Logging.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Planet.Render.Core">
