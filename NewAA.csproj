      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Vulkan">
      <HintPath>$(KsaInstallDir)Brutal.Vulkan.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Vulkan.Abstractions">
      <HintPath>$(KsaInstallDir)Brutal.Vulkan.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Memory">
      <HintPath>$(KsaInstallDir)Brutal.Memory.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.ShaderC">
      <HintPath>$(KsaInstallDir)Brutal.ShaderC.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.ImGui">
      <HintPath>$(KsaInstallDir)Brutal.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Numerics">
